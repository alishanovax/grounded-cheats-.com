---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import SiteFooter from './SiteFooter.astro';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { siteConfig } from '../data/site';
import { getLocalizedPath } from '../data/i18n/routing';
import { absoluteGuideUrl, getGuidesBasePath } from '../data/guides/helpers';
import type { ResolvedExternalGuide } from '../data/guides/types';

interface Props {
	locale?: LocaleCode;
	post: ResolvedExternalGuide;
}

const { post } = Astro.props;
const locale = Astro.props.locale ?? defaultLocale;
const t = post.translation;
const homeHref = getLocalizedPath('home', locale);
const guidesHref = getGuidesBasePath(locale);
const articleUrl = absoluteGuideUrl(t.slug);

const articleSchema = {
	'@type': 'Article',
	'@id': `${articleUrl}#article`,
	url: articleUrl,
	headline: t.title,
	description: t.metaDescription,
	datePublished: post.published,
	dateModified: post.updated,
	image: new URL(post.imageSrc, siteConfig.url).href,
	inLanguage: locale,
	author: { '@type': 'Organization', name: siteConfig.name, url: siteConfig.url },
	publisher: {
		'@type': 'Organization',
		name: siteConfig.name,
		url: siteConfig.url,
		logo: { '@type': 'ImageObject', url: new URL(siteConfig.logoRaster, siteConfig.url).href },
	},
	mainEntityOfPage: { '@type': 'WebPage', '@id': `${articleUrl}#webpage` },
	isPartOf: { '@id': `${siteConfig.url}/#website` },
	keywords: t.keywords.join(', '),
	articleSection: post.game,
};

function pageTitle(headline: string): string {
	const suffix = ' | Guides';
	if (headline.length + suffix.length <= 60) return `${headline}${suffix}`;
	return headline.length <= 60 ? headline : `${headline.slice(0, 57).trim()}…`;
}
---

<Layout
	title={pageTitle(t.title)}
	description={t.metaDescription}
	canonicalPath={post.canonicalPath}
	ogImage={post.imageSrc}
	ogImageAlt={t.imageAlt}
	type="article"
	locale={locale}
	breadcrumbs={[
		{ label: 'Home', href: homeHref },
		{ label: 'Guides', href: guidesHref },
		{ label: t.h1 },
	]}
	extraGraph={[articleSchema]}
>
	<Navbar locale={locale} />
	<main class="guide-post">
		<div class="shell">
			<div class="shell-content guide-post__inner">
				<article>
					<header class="guide-post__header">
						<p class="guide-post__cat">{post.game}</p>
						<h1>{t.h1}</h1>
						<p class="guide-post__intro">{t.intro}</p>
						<p class="guide-post__meta">
							Published {post.published} · Updated {post.updated}
						</p>
					</header>
					<img
						class="guide-post__hero"
						src={post.imageSrc}
						alt={t.imageAlt}
						width="1200"
						height="675"
						loading="eager"
						decoding="async"
					/>
					{
						t.sections.map((section) => (
							<section class="guide-post__section">
								<h2>{section.h2}</h2>
								{section.paragraphs.map((paragraph) => (
									<p>{paragraph}</p>
								))}
							</section>
						))
					}
					<p class="guide-post__closing" set:html={t.closing} />
				</article>
			</div>
		</div>
	</main>
	<SiteFooter locale={locale} />
</Layout>

<style>
	.guide-post {
		padding: 2.5rem 0 4rem;
		background:
			radial-gradient(ellipse 70% 50% at 100% 0%, color-mix(in srgb, #ff8c00 8%, transparent), transparent 50%),
			var(--bg);
	}

	.guide-post__cat {
		margin: 0 0 0.5rem;
		color: #f1c40f;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.guide-post__header h1 {
		margin: 0 0 0.75rem;
		font-size: clamp(1.9rem, 4vw, 2.8rem);
		line-height: 1.1;
	}

	.guide-post__intro {
		color: rgba(255, 255, 255, 0.78);
		font-size: 1.08rem;
	}

	.guide-post__meta {
		color: rgba(255, 255, 255, 0.5);
		font-size: 0.85rem;
	}

	.guide-post__hero {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		margin: 1.5rem 0 2rem;
		border-radius: var(--radius-md);
		border: 1px solid color-mix(in srgb, #1b4d3e 40%, var(--line));
	}

	.guide-post__section {
		margin-bottom: 1.75rem;
	}

	.guide-post__section h2 {
		margin: 0 0 0.75rem;
		font-size: 1.35rem;
	}

	.guide-post__section p {
		margin: 0 0 0.9rem;
		color: rgba(255, 255, 255, 0.78);
		line-height: 1.7;
	}

	.guide-post__closing {
		margin-top: 1.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--line-soft);
		color: rgba(255, 255, 255, 0.72);
		font-size: 0.95rem;
		line-height: 1.65;
	}

	.guide-post__closing :global(a) {
		color: var(--ink-muted);
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.guide-post__closing :global(a:hover) {
		color: var(--ink);
	}
</style>
