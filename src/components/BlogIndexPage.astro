---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import SiteFooter from './SiteFooter.astro';
import { blogUi, type LocaleCode, defaultLocale } from '../data/i18n/locales';
import {
	absoluteBlogUrl,
	getFeaturedPosts,
	getBlogBasePath,
	getBlogIndexHreflangAlternates,
	getPostsGroupedByCategory,
} from '../data/blog/helpers';
import { blogLabel, siteConfig } from '../data/site';
import { brandSeo, seoPageTitle } from '../data/site-core';
import { seoDescription } from '../data/brand';
import { getLocalizedPath } from '../data/i18n/routing';
import { getT } from '../i18n/server';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const ui = blogUi[locale];
const t = getT(locale);
const featured = getFeaturedPosts(locale, 3);
const groups = getPostsGroupedByCategory(locale);
const totalPosts = groups.reduce((n, g) => n + g.posts.length, 0) + featured.length;
const canonicalPath = getBlogBasePath(locale);
const canonicalURL = absoluteBlogUrl(locale);
const hreflangAlternates = getBlogIndexHreflangAlternates(locale);
const homeHref = getLocalizedPath('home', locale);
const [leadFeatured, ...sideFeatured] = featured;

const pageTitle = locale === defaultLocale ? seoPageTitle(brandSeo.blogTitle) : ui.blogTitle;
const pageDescription =
	locale === defaultLocale ? seoDescription(brandSeo.blogDescription) : ui.blogDescription;

const articleListSchema = {
	'@type': 'CollectionPage',
	'@id': `${canonicalURL}#collection`,
	name: ui.blogH1,
	description: pageDescription,
	url: canonicalURL,
	inLanguage: locale,
	isPartOf: { '@id': `${siteConfig.url}/#website` },
	mainEntity: {
		'@type': 'ItemList',
		numberOfItems: totalPosts,
		itemListElement: [...featured, ...groups.flatMap((g) => g.posts)].map((post, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			url: absoluteBlogUrl(locale, post.translation.slug),
			name: post.translation.title,
		})),
	},
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalPath={canonicalPath}
	hreflangAlternates={hreflangAlternates}
	locale={locale}
	ogImage={siteConfig.defaultOgImage}
	ogImageAlt={ui.blogH1}
	breadcrumbs={[{ label: ui.home, href: homeHref }, { label: ui.blogH1 }]}
	extraGraph={[articleListSchema]}
>
	<Navbar locale={locale} />
	<main class="blog">
		<div class="shell blog__inner">
			<header class="blog__hero">
				<p class="blog__eyebrow" data-edit="blogLabel">{blogLabel}</p>
				<h1>{ui.blogH1}</h1>
				<p class="blog__intro">{ui.blogIntro}</p>
				<p class="blog__count">{totalPosts} guides · Updated for Grounded PC</p>
			</header>

			{
				leadFeatured && (
					<section class="blog__featured" aria-label={t('common.featured')}>
						<a class="blog__lead" href={leadFeatured.canonicalPath}>
							<img
								src={leadFeatured.imageSrc}
								alt={leadFeatured.translation.imageAlt}
								width="960"
								height="540"
								loading="eager"
								decoding="async"
								fetchpriority="high"
							/>
							<div class="blog__lead-copy">
								<span class="blog__cat">{leadFeatured.category}</span>
								<h2>{leadFeatured.translation.title}</h2>
								<p>{leadFeatured.translation.intro}</p>
								<span class="blog__more">{ui.readMore}</span>
							</div>
						</a>
						{
							sideFeatured.length > 0 && (
								<div class="blog__featured-side">
									{sideFeatured.map((post) => (
										<a class="blog__side-card" href={post.canonicalPath}>
											<img
												src={post.imageSrc}
												alt={post.translation.imageAlt}
												width="480"
												height="270"
												loading="lazy"
												decoding="async"
											/>
											<div>
												<span class="blog__cat">{post.category}</span>
												<h3>{post.translation.title}</h3>
											</div>
										</a>
									))}
								</div>
							)
						}
					</section>
				)
			}

			{
				groups.map((group) => (
					<section class="blog__group" aria-labelledby={`blog-cat-${group.category.replace(/\s+/g, '-').toLowerCase()}`}>
						<div class="blog__group-head">
							<h2 id={`blog-cat-${group.category.replace(/\s+/g, '-').toLowerCase()}`}>{group.category}</h2>
							<span class="blog__group-count">{group.posts.length}</span>
						</div>
						<div class="blog__grid">
							{group.posts.map((post) => (
								<article class="blog__card">
									<a href={post.canonicalPath}>
										<img
											src={post.imageSrc}
											alt={post.translation.imageAlt}
											width="480"
											height="270"
											loading="lazy"
											decoding="async"
										/>
										<div class="blog__card-body">
											<span class="blog__cat">{post.category}</span>
											<h3>{post.translation.title}</h3>
											<p>{post.translation.intro}</p>
											<span class="blog__meta">
												{ui.updated} {post.updated}
											</span>
										</div>
									</a>
								</article>
							))}
						</div>
					</section>
				))
			}
		</div>
	</main>
	<SiteFooter locale={locale} />
</Layout>

<style>
	.blog {
		padding: 2.25rem 0 4rem;
		background:
			radial-gradient(ellipse 80% 50% at 0% 0%, color-mix(in srgb, #ff8c00 10%, transparent), transparent 55%),
			var(--bg);
	}

	.blog__inner {
		display: grid;
		gap: 2.5rem;
	}

	.blog__hero {
		max-width: 44rem;
	}

	.blog__eyebrow {
		margin: 0 0 0.5rem;
		color: #f1c40f;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		font-size: 0.75rem;
	}

	.blog__hero h1 {
		margin: 0 0 0.75rem;
		font-family: var(--font-display);
		font-size: clamp(2rem, 4.5vw, 3rem);
		line-height: 1.08;
		letter-spacing: -0.03em;
		color: var(--ink);
	}

	.blog__intro {
		margin: 0;
		max-width: 40rem;
		color: var(--ink-muted);
		font-size: 1.02rem;
		line-height: 1.65;
	}

	.blog__count {
		margin: 0.75rem 0 0;
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--ink-faint);
	}

	.blog__featured {
		display: grid;
		grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
		gap: 1rem;
	}

	.blog__lead {
		display: flex;
		flex-direction: column;
		min-height: 100%;
		border: 1px solid color-mix(in srgb, #1b4d3e 40%, var(--line));
		border-radius: var(--radius-lg);
		overflow: hidden;
		background: var(--bg-panel);
		text-decoration: none;
		color: inherit;
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.blog__lead:hover {
		border-color: color-mix(in srgb, #ff8c00 40%, var(--line));
		box-shadow: 0 12px 32px color-mix(in srgb, #ff8c00 12%, transparent);
	}

	.blog__lead img {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	.blog__lead-copy {
		display: grid;
		gap: 0.55rem;
		padding: 1.15rem 1.2rem 1.25rem;
	}

	.blog__lead-copy h2 {
		margin: 0;
		font-size: clamp(1.2rem, 2vw, 1.55rem);
		line-height: 1.2;
	}

	.blog__lead-copy p {
		margin: 0;
		color: var(--ink-muted);
		font-size: 0.92rem;
		line-height: 1.55;
	}

	.blog__featured-side {
		display: grid;
		gap: 1rem;
	}

	.blog__side-card {
		display: grid;
		grid-template-columns: 7.5rem minmax(0, 1fr);
		gap: 0.85rem;
		align-items: center;
		padding: 0.75rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--bg-panel);
		text-decoration: none;
		color: inherit;
		transition: border-color 0.2s ease;
	}

	.blog__side-card:hover {
		border-color: color-mix(in srgb, #ff8c00 35%, var(--line));
	}

	.blog__side-card img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: calc(var(--radius-md) - 4px);
	}

	.blog__side-card h3 {
		margin: 0.25rem 0 0;
		font-size: 0.95rem;
		line-height: 1.3;
	}

	.blog__group {
		display: grid;
		gap: 1rem;
	}

	.blog__group-head {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding-bottom: 0.65rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.blog__group-head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.15rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.blog__group-count {
		display: inline-flex;
		align-items: center;
		min-height: 1.5rem;
		padding: 0 0.5rem;
		border-radius: 999px;
		background: color-mix(in srgb, #1b4d3e 35%, var(--bg-elevated));
		color: #f1c40f;
		font-size: 0.72rem;
		font-weight: 700;
	}

	.blog__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.blog__card a {
		display: flex;
		flex-direction: column;
		height: 100%;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		overflow: hidden;
		background: var(--bg-panel);
		text-decoration: none;
		color: inherit;
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.blog__card a:hover {
		border-color: color-mix(in srgb, #ff8c00 35%, var(--line));
		transform: translateY(-2px);
	}

	.blog__card img {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	.blog__card-body {
		display: grid;
		gap: 0.4rem;
		padding: 0.9rem 1rem 1rem;
		flex: 1;
	}

	.blog__card h3 {
		margin: 0;
		font-size: 1rem;
		line-height: 1.3;
	}

	.blog__card p {
		margin: 0;
		color: var(--ink-muted);
		font-size: 0.86rem;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		overflow: hidden;
	}

	.blog__cat {
		display: inline-block;
		color: #f1c40f;
		font-size: 0.68rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.07em;
	}

	.blog__more,
	.blog__meta {
		display: inline-block;
		margin-top: 0.35rem;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--ink-faint);
	}

	.blog__more {
		color: #ff8c00;
	}

	@media (max-width: 960px) {
		.blog__featured {
			grid-template-columns: 1fr;
		}

		.blog__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 600px) {
		.blog__grid {
			grid-template-columns: 1fr;
		}

		.blog__side-card {
			grid-template-columns: 6.5rem minmax(0, 1fr);
		}
	}
</style>
