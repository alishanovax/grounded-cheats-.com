---
import HomeAboutApp from './react/HomeAbout';
import { productInfo, siteConfig } from '../data/site';
import type { LocaleCode } from '../data/i18n/locales';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const monthly = productInfo.plans.find((p) => p.id === 'monthly') ?? productInfo.plans[0];
---

<HomeAboutApp
	client:visible
	locale={locale}
	checkoutUrl={siteConfig.checkoutUrl}
	monthlyPrice={monthly.price}
/>

<style is:global>
	.home-intro {
		padding-block: clamp(2.25rem, 4.5vw, 3.25rem);
		border-bottom: 1px solid var(--line-soft);
		background:
			radial-gradient(ellipse 85% 70% at 0% 0%, color-mix(in srgb, #ff8c00 14%, transparent), transparent 55%),
			radial-gradient(ellipse 60% 50% at 100% 100%, color-mix(in srgb, #1b4d3e 35%, transparent), transparent 50%),
			var(--bg-panel);
	}

	.home-intro__inner {
		display: grid;
		gap: 1.75rem;
	}

	.home-intro__eyebrow {
		margin: 0 0 0.5rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #f1c40f;
	}

	.home-intro__head h2 {
		margin: 0;
		max-width: 22ch;
		font-family: var(--font-display);
		font-size: clamp(1.45rem, 2.8vw, 2rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.15;
		color: var(--ink);
	}

	.home-intro__lede {
		margin: 0.85rem 0 0;
		max-width: 42rem;
		font-size: clamp(0.9375rem, 1.4vw, 1.02rem);
		line-height: 1.65;
		color: var(--ink-muted);
	}

	.home-intro__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.65rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.home-intro__card {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		height: 100%;
		min-height: 7.5rem;
		padding: 1rem 1rem 0.95rem;
		border: 1px solid color-mix(in srgb, #1b4d3e 45%, var(--line));
		border-radius: var(--radius-md);
		background: color-mix(in srgb, var(--bg) 40%, var(--bg-elevated));
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.home-intro__card:hover {
		border-color: color-mix(in srgb, #ff8c00 45%, var(--line));
		box-shadow: 0 8px 28px color-mix(in srgb, #ff8c00 12%, transparent);
		transform: translateY(-2px);
	}

	.home-intro__card-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.15rem;
		height: 2.15rem;
		border-radius: 0.65rem;
		background: color-mix(in srgb, #ff8c00 16%, transparent);
		color: #f1c40f;
	}

	.home-intro__card-icon svg {
		width: 1.15rem;
		height: 1.15rem;
	}

	.home-intro__card-text {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
	}

	.home-intro__card-text strong {
		font-size: 0.9rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.home-intro__card-text span {
		font-size: 0.78rem;
		line-height: 1.4;
		color: var(--ink-faint);
	}

	.home-intro__card-arrow {
		width: 0.35rem;
		height: 0.35rem;
		margin-top: auto;
		align-self: flex-end;
		border-right: 1.5px solid #f1c40f;
		border-bottom: 1.5px solid #f1c40f;
		transform: rotate(-45deg);
		opacity: 0.5;
		transition: opacity 0.15s ease;
	}

	.home-intro__card:hover .home-intro__card-arrow {
		opacity: 1;
	}

	.home-intro__guides {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem 0.85rem;
	}

	.home-intro__guides-label {
		margin: 0;
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--ink-faint);
	}

	.home-intro__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.home-intro__chips a {
		display: inline-flex;
		align-items: center;
		min-height: 2rem;
		padding: 0.35rem 0.8rem;
		border: 1px solid color-mix(in srgb, #1b4d3e 50%, var(--line));
		border-radius: 999px;
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--ink-muted);
		text-decoration: none;
		background: color-mix(in srgb, var(--bg) 50%, transparent);
		transition:
			border-color 0.15s ease,
			color 0.15s ease,
			background 0.15s ease;
	}

	.home-intro__chips a:hover {
		border-color: color-mix(in srgb, #ff8c00 40%, var(--line));
		color: #f1c40f;
		background: color-mix(in srgb, #ff8c00 10%, transparent);
	}

	.home-intro__cta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.85rem 1rem;
		padding-top: 0.25rem;
	}

	.home-intro__buy {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		min-height: 2.85rem;
		padding: 0.5rem 0.5rem 0.5rem 1.05rem;
		border-radius: 999px;
		background: linear-gradient(135deg, #ff8c00 0%, #f1c40f 100%);
		color: #1a1208;
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
		box-shadow: 0 8px 24px color-mix(in srgb, #ff8c00 28%, transparent);
		transition: transform 0.18s ease, box-shadow 0.18s ease;
	}

	.home-intro__buy:hover {
		transform: translateY(-1px);
		box-shadow: 0 12px 28px color-mix(in srgb, #ff8c00 38%, transparent);
		color: #1a1208;
	}

	.home-intro__buy-price {
		display: inline-flex;
		align-items: center;
		min-height: 1.9rem;
		padding: 0 0.75rem;
		border-radius: 999px;
		background: #1b4d3e;
		color: #f1c40f;
		font-size: 0.78rem;
		font-weight: 700;
	}

	.home-intro__secondary {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--magenta-soft);
		text-decoration: none;
	}

	.home-intro__secondary:hover {
		color: var(--ink);
	}

	@media (max-width: 900px) {
		.home-intro__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 520px) {
		.home-intro__grid {
			grid-template-columns: 1fr;
		}

		.home-intro__card {
			min-height: 0;
			flex-direction: row;
			align-items: center;
		}

		.home-intro__card-arrow {
			margin-top: 0;
		}

		.home-intro__buy {
			width: 100%;
			justify-content: flex-start;
		}
	}
</style>
